# Copy to .env and fill in values

# PostgreSQL connection string.
# Local: postgresql://postgres:student@localhost:5432/commerce?schema=public
# Render: use the "Internal Database URL" from your Render PostgreSQL instance.
DATABASE_URL="postgresql://postgres:student@localhost:5432/commerce?schema=public"

# Long random string used to sign session tokens (min 32 chars).
# Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Public base URL of the deployed app (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe TEST mode keys — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Optional: only needed if you configure the Stripe webhook endpoint.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email — used for password-reset messages.
# Option 1: SMTP (e.g. a Gmail App Password) — sends to any address, no domain needed.
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<16-char app password>
# Option 2: Resend (https://resend.com) — needs a verified domain to send to arbitrary addresses.
# If neither is set, the reset link is shown in the UI instead of emailed.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
EMAIL_FROM="Velora <you@gmail.com>"
