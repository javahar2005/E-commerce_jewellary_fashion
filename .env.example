# Copy to .env and fill in values

# PostgreSQL connection string.
# Local: postgresql://postgres:student@localhost:5432/commerce?schema=public
# Render: use the "Internal Database URL" from your Render PostgreSQL instance.
DATABASE_URL="postgresql://postgres:student@localhost:5432/commerce?schema=public"

# Long random string used to sign session tokens (min 32 chars).
# Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Public base URL of the deployed app (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe TEST mode keys — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Optional: only needed if you configure the Stripe webhook endpoint.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email via Resend — https://resend.com/api-keys
# If RESEND_API_KEY is blank, password reset falls back to a dev flow that
# shows the reset link in the UI instead of emailing it.
RESEND_API_KEY=""
EMAIL_FROM="Velora <onboarding@resend.dev>"
